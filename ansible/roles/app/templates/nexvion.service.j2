# Managed by Ansible (role: app). Starts the Docker Compose stack at boot.
[Unit]
Description=Nexvion platform (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ nexvion_dir }}/docker
ExecStart=/usr/bin/docker compose {{ app_profiles }} up -d
ExecStop=/usr/bin/docker compose {{ app_profiles }} down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
